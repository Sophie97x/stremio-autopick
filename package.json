{
  "name": "autopick-stremio-addon",
  "version": "1.2.0",
  "private": true,
  "description": "A stateless Stremio addon that selects the best sensible torrent stream.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:addon": "node scripts/publish-addon.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ipaddr.js": "^2.2.0",
    "pino": "^10.1.0",
    "stremio-addon-sdk": "^1.6.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.0",
    "@types/stremio-addon-sdk": "^1.6.12",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.13"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "tmp": "0.2.7"
  }
}
